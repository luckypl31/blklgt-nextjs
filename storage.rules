rules_version = '2';

// Posters and stills are public read. That's what lets mediaUrl() build a
// plain ?alt=media link with no expiring token in it — tokens regenerate on
// re-upload and every stored reference dies with them.

service firebase.storage {
  match /b/{bucket}/o {

    match /images/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /videos/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Nothing else is writable from a browser.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
